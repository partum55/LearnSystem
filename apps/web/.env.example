# Next.js frontend environment variables

# Remote Supabase project settings from Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key. Never expose this in client code or NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=

# Optional compatibility endpoints for features not yet implemented as direct Supabase queries
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_AI_SERVICE_URL=/api/ai

# Optional feature flags
NEXT_PUBLIC_REQUIRE_UCU_EMAIL=false
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
NEXT_PUBLIC_PDF_EMBED_ALLOWLIST=
