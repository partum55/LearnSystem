# ==========================================
# LearnSystem — Caddy Production Config
# ==========================================
# TLS certificates are obtained automatically via Let's Encrypt.
# DNS for api.learnsystem.app must point to this server before starting.
#
# Local development: Caddy does not run locally (profiles: [prod]).
# Run locally with ./scripts/dev.sh instead.

api.learnsystem.app {
    reverse_proxy gateway:8080

    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }

    log {
        output stdout
    }
}
