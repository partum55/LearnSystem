# Local Docker Compose environment using Cloud Supabase

# Supabase Database Configuration
# JDBC URL for Java: jdbc:postgresql://<host>:<port>/<db>
SUPABASE_DB_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:6543/postgres
SUPABASE_DB_USER=postgres.aarkyaevxuhlkefayzro
SUPABASE_DB_PASSWORD=<your-db-password>

# Supabase API Configuration
SUPABASE_URL=https://aarkyaevxuhlkefayzro.supabase.co
SUPABASE_JWKS_URL=https://aarkyaevxuhlkefayzro.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_SECRET_KEY=<sb_secret_...>

# JWT Security (Legacy - prefer JWKS)
SUPABASE_JWT_SECRET=<legacy-secret-not-used-for-jwks>

# AI Service (Groq API Key)
LLAMA_API_KEY=<your-groq-api-key>

# Application settings
SPRING_PROFILES_ACTIVE=docker,supabase,local
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_EMAIL=admin@ucu.edu.ua
BOOTSTRAP_ADMIN_PASSWORD=Admin123!
GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:3000
